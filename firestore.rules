rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/wallets/{walletId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.userId == userId
          && request.resource.data.id == walletId;
      allow delete: if request.auth != null && request.auth.uid == userId;

      match /{collection}/{documentId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null
            && request.auth.uid == userId
            && (
              (collection == 'categories'
                && request.resource.data.keys().hasOnly(['name', 'type', 'updatedAt'])
                && request.resource.data.name is string
                && request.resource.data.type is string
                && request.resource.data.updatedAt is string)
              || (collection == 'subcategories'
                && request.resource.data.keys().hasOnly(['categoryId', 'name', 'updatedAt'])
                && request.resource.data.categoryId is string
                && request.resource.data.name is string
                && request.resource.data.updatedAt is string)
              || (collection == 'transactions'
                && request.resource.data.keys().hasOnly([
                  'title', 'amount', 'categoryId', 'date', 'note', 'type', 'updatedAt'
                ])
                && request.resource.data.title is string
                && request.resource.data.amount is number
                && request.resource.data.categoryId is string
                && request.resource.data.date is string
                && (request.resource.data.note == null
                    || request.resource.data.note is string)
                && request.resource.data.type is string
                && request.resource.data.updatedAt is string)
              || (collection == 'budgets'
                && request.resource.data.keys().hasOnly([
                  'id', 'userId', 'walletId', 'categoryId', 'amount',
                  'monthYear', 'updatedAt'
                ])
                && request.resource.data.id == documentId
                && request.resource.data.userId == userId
                && request.resource.data.walletId == walletId
                && request.resource.data.categoryId is string
                && request.resource.data.amount is number
                && request.resource.data.monthYear is string
                && request.resource.data.updatedAt is string)
              || (collection == 'notes'
                && request.resource.data.keys().hasOnly([
                  'id', 'userId', 'walletId', 'title', 'content',
                  'createdAt', 'updatedAt'
                ])
                && request.resource.data.id == documentId
                && request.resource.data.userId == userId
                && request.resource.data.walletId == walletId
                && request.resource.data.title is string
                && request.resource.data.content is string
                && request.resource.data.createdAt is string
                && request.resource.data.updatedAt is string)
            );
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
