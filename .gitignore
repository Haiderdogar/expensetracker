# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
**/build/
/coverage/

# Generated iOS Flutter and CocoaPods files
/ios/Flutter/Generated.xcconfig
/ios/Flutter/flutter_export_environment.sh
/ios/Flutter/ephemeral/
/ios/Pods/
/ios/.symlinks/
/ios/Runner.xcworkspace/xcuserdata/
/ios/Runner.xcodeproj/xcuserdata/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android local configuration and build output
/android/.gradle/
/android/local.properties
/android/key.properties
/android/app/debug
/android/app/profile
/android/app/release

# Local environment files (keep safe example templates)
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Signing keys and certificates
**/*.jks
**/*.keystore
**/*.pem
**/*.p12
**/*.pfx
**/*.key

# Firebase client configuration and local tooling credentials
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
**/google-services.json
**/GoogleService-Info.plist
**/*firebase-adminsdk*.json
**/*service-account*.json
encoded.txt
.firebase/
firebase-debug.log
